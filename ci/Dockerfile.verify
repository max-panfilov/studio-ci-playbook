# Pinned verification tooling; the test itself runs with network access disabled.
FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
RUN groupadd --gid 65532 verifier \
 && useradd --uid 65532 --gid verifier --no-create-home --home-dir /tmp --shell /usr/sbin/nologin verifier
WORKDIR /opt/verifier
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=studio-ci-playbook-uv-v1,target=/root/.cache/uv uv sync --frozen --no-install-project
ENV PATH="/opt/verifier/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
USER verifier
